#!/bin/sh
set -eu

if [ -n "${RISCV_PREFIX:-}" ]; then
    if [ ! -x "${RISCV_PREFIX}gcc" ]; then
        echo "RISCV_PREFIX does not name an executable GCC prefix: ${RISCV_PREFIX}" >&2
        exit 1
    fi
    printf '%s\n' "$RISCV_PREFIX"
    exit 0
fi

if command -v riscv-none-elf-gcc >/dev/null 2>&1; then
    compiler=$(command -v riscv-none-elf-gcc)
    printf '%s\n' "${compiler%gcc}"
    exit 0
fi

common_dir=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || {
    echo "cannot locate the Git common directory" >&2
    exit 1
}
main_root=$(dirname "$common_dir")
toolchain_bin="$main_root/.aisl/toolchains/xpack-riscv-none-elf-gcc-14.2.0-3/bin"
if [ -x "$toolchain_bin/riscv-none-elf-gcc" ]; then
    printf '%s\n' "$toolchain_bin/riscv-none-elf-"
    exit 0
fi

echo "RISC-V toolchain unavailable; run workspace/tools/bootstrap-riscv-toolchain" >&2
exit 1
