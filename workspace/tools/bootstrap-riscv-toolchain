#!/bin/sh
set -eu

version=14.2.0-3
archive_name=xpack-riscv-none-elf-gcc-14.2.0-3-darwin-arm64.tar.gz
archive_sha256=e76e86b8c500f8e92b3b4ff7b0444cfbf3b218515f322929e0744ec3b9ed80a8
url="https://github.com/xpack-dev-tools/riscv-none-elf-gcc-xpack/releases/download/v${version}/${archive_name}"

if [ "$(uname -s)" != Darwin ] || [ "$(uname -m)" != arm64 ]; then
    echo "this pinned bootstrap is validated only for Darwin arm64" >&2
    echo "install xPack RISC-V Embedded GCC ${version} and set RISCV_PREFIX" >&2
    exit 1
fi

common_dir=$(git rev-parse --path-format=absolute --git-common-dir)
main_root=$(dirname "$common_dir")
download_dir="$main_root/.aisl/downloads"
toolchain_dir="$main_root/.aisl/toolchains"
archive="$download_dir/$archive_name"
destination="$toolchain_dir/xpack-riscv-none-elf-gcc-${version}"

mkdir -p "$download_dir" "$toolchain_dir"
if [ ! -f "$archive" ]; then
    curl -fL --retry 3 -o "$archive" "$url"
fi
printf '%s  %s\n' "$archive_sha256" "$archive" | shasum -a 256 -c -
if [ ! -d "$destination" ]; then
    tar -xzf "$archive" -C "$toolchain_dir"
fi

"$destination/bin/riscv-none-elf-gcc" --version | sed -n '1p'
printf '%s\n' "$destination/bin"
