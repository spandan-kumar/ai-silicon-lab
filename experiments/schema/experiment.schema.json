{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-silicon-lab.invalid/schema/experiment.schema.json",
  "title": "AI Silicon Lab experiment specification",
  "type": "object",
  "required": [
    "schema_version",
    "experiment_id",
    "title",
    "status",
    "domain",
    "objective",
    "scope",
    "design_space",
    "workloads",
    "correctness",
    "metrics",
    "gates",
    "phases",
    "provenance_requirements",
    "research"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "experiment_id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "title": { "type": "string", "minLength": 1 },
    "status": { "type": "string" },
    "domain": { "type": "string", "minLength": 1 },
    "objective": { "type": "string", "minLength": 1 },
    "scope": { "type": "object" },
    "design_space": { "type": "object" },
    "workloads": { "type": "array", "minItems": 1 },
    "correctness": { "type": "object" },
    "metrics": { "type": "array", "minItems": 1 },
    "gates": { "type": "array", "minItems": 1 },
    "phases": { "type": "array", "minItems": 1 },
    "provenance_requirements": { "type": "array", "minItems": 1 },
    "research": { "type": "array", "minItems": 1 }
  },
  "additionalProperties": true
}
